# ============================================================
# Shore — dev 环境配置示例
# 复制: cp backend/.env.dev.example backend/.env.dev
# 启动: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# ============================================================

ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO

# 若与 test 实例同机部署，dev overlay 已映射 5434/6381/8001/3457，库名可共用 shore 或单独库
DATABASE_URL=postgresql+asyncpg://shore:shore@postgres:5432/shore
DATABASE_URL_SYNC=postgresql+psycopg2://shore:shore@postgres:5432/shore
REDIS_URL=redis://redis:6379/0

# ---- 对接 dev 基础设施（按实际填写） ----
PROMETHEUS_URL=
PROMETHEUS_SSL_VERIFY=false
PROMETHEUS_USERNAME=
ES_HOST=
ES_PORT=9200
ES_USER=elastic

K8S_IN_CLUSTER=false
K8S_CONTEXT=dev
CLUSTER_NAME=dev
DISCOVERY_INTERVAL=300

# GitLab：dev 实例可只扫 dev 分支
GITLAB_CI_SCAN_ENABLED=true
GITLAB_URL=
GITLAB_GROUP_ID=
GITLAB_CI_BRANCHES=dev
GITLAB_CI_SCAN_INTERVAL=120
GITLAB_SSL_VERIFY=true

ARGOCD_DEV_SERVER=
ARGOCD_DEV_USERNAME=admin
ARGOCD_TEST_SERVER=
ARGOCD_TEST_USERNAME=admin
ARGOCD_CLI_EXTRA=--plaintext --insecure --grpc-web
BUILD_OBSERVE_MODE=true
AUTO_ROLLBACK=true

PUBLIC_URL=http://localhost:3457
CORS_ORIGINS=["http://localhost:3457"]

LOG_MONITOR_ENABLED=true
INSPECTION_ENABLED=true
INSPECTION_CRON=0 8 * * *
