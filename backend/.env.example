# ============================================================
# Shore Backend — .env.example
# 敏感项放 .env.secrets（复制 .env.secrets.example）
# 架构蓝图：backend/config/environment-architecture.json
# ============================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql+asyncpg://shore:shore@localhost:5432/shore
DATABASE_URL_SYNC=postgresql://shore:shore@localhost:5432/shore

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Observability ----
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_SSL_VERIFY=false
PROMETHEUS_USERNAME=
ES_HOST=
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=

# ---- LLM（OpenAI 兼容 API） ----
# 任选其一配置；推荐 LLM_*，旧项目可继续用 DEEPSEEK_*
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---- Auth ----
SECRET_KEY=dev-only-insecure-key-change-in-production-min-32c
AUTH_REQUIRED=false
ADMIN_PASSWORD=admin123
ALERTMANAGER_WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL=
AUTO_DIAGNOSE_ON_ALERT=true

# ---- Infra Discovery ----
# K8s 凭证在 设置 → K8s 集群凭证 粘贴入库，无需 KUBECONFIG 环境变量
K8S_IN_CLUSTER=false
CLUSTER_NAME=default
DISCOVERY_INTERVAL=300

# ---- Security Scan ----
SCAN_TOOLS_PATH=/usr/local/bin
AUTO_SCAN_CRON=0 3 * * *
# 全平台漏洞扫描额外目标（逗号分隔），如对外 Ingress 域名
SECURITY_SCAN_EXTRA_TARGETS=

# ---- GitLab CI 只读扫描（推荐，无需改各项目 CI） ----
GITLAB_CI_SCAN_ENABLED=true
GITLAB_URL=gitlab.test.exc888.org
GITLAB_TOKEN=                         # 只读 Token（read_api）
GITLAB_GROUP_ID=                      # 服务所在 Group ID；或用 GITLAB_PROJECTS
GITLAB_PROJECTS=                      # 逗号分隔 path，如 sre/exchange-uc,jys/exchange-gateway
GITLAB_CI_BRANCHES=dev,test,main
GITLAB_CI_SCAN_INTERVAL=120
GITLAB_CI_MAX_PIPELINE_AGE_HOURS=72
GITLAB_SSL_VERIFY=true

# ---- Deployments (optional webhook) ----
GITLAB_WEBHOOK_TOKEN=
# ---- ArgoCD（按 dev/test 分支区分） ----
ARGOCD_DEV_SERVER=
ARGOCD_DEV_USERNAME=admin
ARGOCD_DEV_PASSWORD=
ARGOCD_TEST_SERVER=
ARGOCD_TEST_USERNAME=admin
ARGOCD_TEST_PASSWORD=
ARGOCD_CLI_EXTRA=--plaintext --insecure --grpc-web
ARGOCD_SSL_VERIFY=false
# 兼容旧单环境
ARGOCD_SERVER=
ARGOCD_TOKEN=
DEPLOY_VERIFY_WAIT=60
AUTO_ROLLBACK=true
BUILD_OBSERVE_MODE=true
BUILD_SLOW_THRESHOLD_SEC=600
BUILD_SLOW_RATIO=1.5
BUILD_HISTORY_PER_SERVICE=1
BUILD_NOTIFY_SLOW=false

# ---- Log Monitor ----
LOG_MONITOR_ENABLED=true
LOG_MONITOR_DIR=
PUBLIC_URL=http://localhost:3456

# ---- Ops Agents ----
MONITOR_PATROL_ENABLED=true
MONITOR_PATROL_INTERVAL=900
COST_ANALYSIS_ENABLED=true
COST_CPU_CORE_HOUR_USD=0.04
COST_MEM_GB_HOUR_USD=0.005
ARCHITECTURE_CRON=0 9 * * 1
OPS_AUTO_REMEDIATE=false

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3456"]
